# Copy this file to .env and fill in the values you want to use.
#
# Leave WALLET_PRIVATE_KEY EMPTY to run the demo in "no-funds" mode:
# the agent will only call the FREE /signals/preview endpoint and print
# the x402 402-challenge for a paid endpoint, without spending anything.
#
# To run REAL paid calls (each spends a few cents of USDC on Base mainnet)
# put the private key of a LOW-BALANCE, DEDICATED Base hot wallet here.
# Never use your main wallet. Never commit a real private key.
WALLET_PRIVATE_KEY=

# Base URL of the live signals API. Defaults to the production deployment.
BASE_URL=https://signals.nsgoods.org
